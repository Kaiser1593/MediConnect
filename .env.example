# Variables utilisées par docker-compose.yml (docker compose charge
# automatiquement un fichier .env placé à côté de lui).
# Copier ce fichier en .env à la racine et renseigner de vraies valeurs :
# le .env réel n'est jamais versionné (voir .gitignore).

DB_NAME=mediconnect
DB_PASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
