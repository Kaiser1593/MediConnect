# Variables utilisées par docker-compose.yml (docker compose charge
# automatiquement un fichier .env placé à côté de lui).
# Copier ce fichier en .env à la racine et renseigner de vraies valeurs :
# le .env réel n'est jamais versionné (voir .gitignore).

DB_NAME=mediconnect
DB_PASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Envoi d'e-mails (réinitialisation de mot de passe). SMTP_PASSWORD est un
# "mot de passe d'application" Gmail, pas le mot de passe du compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=change-me

# URL publique du frontend, utilisée pour construire le lien envoyé par
# e-mail. En local avec Docker, c'est le port du service frontend (8080).
FRONTEND_URL=http://localhost:8080
